{
	"name": "abso-server",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "abso's open server: one Worker with a Durable Object per project, on your own Cloudflare account.",
	"license": "MIT",
	"scripts": {
		"dev": "wrangler dev --local",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"install:git-runtime": "node scripts/capacity-install-git-runtime.mjs --root node_modules/isomorphic-git",
		"check:git-runtime": "node scripts/capacity-install-git-runtime.mjs --root node_modules/isomorphic-git --check",
		"postinstall": "npm run install:git-runtime",
		"predev": "npm run check:git-runtime",
		"predeploy": "npm run check:git-runtime"
	},
	"dependencies": {
		"isomorphic-git": "1.44.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261001.1",
		"@types/node": "^24.19.1",
		"typescript": "^5.9.3",
		"wrangler": "^4.147.0"
	}
}
